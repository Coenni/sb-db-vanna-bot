# OpenAI API Key (required for Vanna AI)
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI Model (optional, defaults to gpt-3.5-turbo)
OPENAI_MODEL=gpt-3.5-turbo

# Automatic Training on Startup (optional, defaults to true)
# When enabled, Vanna will automatically train itself on first startup
# by discovering the database schema and loading predefined examples.
# Set to 'false' to disable automatic training.
AUTO_TRAIN_ON_STARTUP=true
