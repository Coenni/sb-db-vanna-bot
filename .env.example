# ============================================================================
# LLM Provider Configuration
# ============================================================================

# Choose LLM Provider: 'openai' (requires internet) or 'ollama' (offline)
# Default: openai
LLM_PROVIDER=openai

# ============================================================================
# OpenAI Configuration (when LLM_PROVIDER=openai)
# ============================================================================

# OpenAI API Key (required for OpenAI provider)
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI Model (optional, defaults to gpt-3.5-turbo)
OPENAI_MODEL=gpt-3.5-turbo

# ============================================================================
# Ollama Configuration (when LLM_PROVIDER=ollama)
# ============================================================================

# Ollama Host (optional, defaults to http://localhost:11434)
# If running Ollama in Docker, use: http://ollama:11434
OLLAMA_HOST=http://localhost:11434

# Ollama Model (optional, defaults to llama2)
# Popular options: llama2, mistral, codellama, llama3, mixtral
# Run 'ollama list' to see available models
OLLAMA_MODEL=llama2

# ============================================================================
# General Configuration
# ============================================================================

# Automatic Training on Startup (optional, defaults to true)
# When enabled, Vanna will automatically train itself on first startup
# by discovering the database schema and loading predefined examples.
# Set to 'false' to disable automatic training.
AUTO_TRAIN_ON_STARTUP=true
